{
  "manifest_version": 3,
  "name": "pw-recorder v2 Agent",
  "version": "2.0.0",
  "description": "在任何页面注入 pw-recorder 录制器：录下操作并导出 JavaScript / Python / Java 自动化脚本。",
  "homepage_url": "https://github.com/lxf-lxf/pw-recoder",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["pw-agent.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
